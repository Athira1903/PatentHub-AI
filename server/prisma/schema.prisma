generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // Inventor, Guide, CoInventor, PatentExpert, Admin
  permissions String[] @default([])
  users       User[]
}

enum ProjectStage {
  IDEA
  INNOVATION_DETAILS
  LITERATURE_REVIEW
  PRIOR_ART_ANALYSIS
  PROTOTYPE
  CLAIM_DRAFTING
  DOCUMENTATION
  FORMS_PREPARATION
  GUIDE_REVIEW
  PATENT_EXPERT_REVIEW
  REVIEW
  CHANGES_REQUESTED
  RESUBMISSION
  FILING_READY
  FILED
}

enum ProjectRole {
  INVENTOR
  CO_INVENTOR
  GUIDE
  PATENT_EXPERT
}

enum PermissionLevel {
  VIEW
  EDIT
  SUBMIT
}

enum AccountType {
  INDIVIDUAL
  ORGANIZATION
}

model User {
  id                   String    @id @default(uuid())
  fullName             String
  username             String    @unique
  email                String    @unique
  password             String
  institution          String?
  accountType          AccountType @default(INDIVIDUAL)
  organizationId       String?
  organization         Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  roleId               String
  role                 Role      @relation(fields: [roleId], references: [id])
  isActive             Boolean   @default(true)
  employeeOrStudentId   String?
  activationOtp         String?
  activationOtpExpires  DateTime?
  resetOtp             String?
  resetOtpExpires      DateTime?
  resetOtpAttempts     Int?      @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  profile             Profile?
  projectMembers      ProjectMember[]
  sentInvitations     Invitation[]     @relation("InvitationSender")
  receivedInvitations Invitation[]     @relation("InvitationReceiver")
  notifications       Notification[]
  activityLogs        ActivityLog[]
  assignedTasks       Task[]           @relation("TaskAssignee")
  comments            Comment[]
  legacyPatents       Patent[]
  ownedProjects       PatentProject[]  @relation("ProjectOwner")
  projectReviews      ProjectReview[]
  loginOtps           LoginOtp[]
  createdPolicies     Policy[]         @relation("CreatedPolicies")
  assignedPolicies    PolicyAssignment[] @relation("UserPolicyAssignments")
  assignedByPolicies  PolicyAssignment[] @relation("PolicyAssigner")
  revokedByPolicies   PolicyAssignment[] @relation("PolicyRevoker")
}

model PatentProject {
  id                  String       @id @default(uuid())
  title               String
  innovationIdea      String       @db.Text
  problemStatement    String       @db.Text
  existingSolutions   String?      @db.Text
  drawbacks           String?      @db.Text
  proposedSolution    String       @db.Text
  objectives          String?      @db.Text
  novelFeatures       String?      @db.Text
  technicalDomain     String
  keywords            String?      @db.Text
  category            String
  patentCategory      String?      @default("PRODUCT") // PRODUCT, PROCESS, PRODUCT_AND_PROCESS
  specificationType   String?      @default("COMPLETE") // PROVISIONAL, COMPLETE
  domainQuestionsData Json?
  stage               ProjectStage @default(IDEA)
  expectedFilingDate  DateTime?
  patentType          String?
  visibility          String       @default("PRIVATE")
  isArchived          Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  ownerId String
  owner   User   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members            ProjectMember[]
  documents          Document[]
  tasks              Task[]
  comments           Comment[]
  activityLogs       ActivityLog[]
  notifications      Notification[]
  invitations        Invitation[]
  patentReferences   PatentReference[]
  patentForms        PatentForm[]
  projectReviews     ProjectReview[]
  prototypes         Prototype[]
  drawingFigures     DrawingFigure[]
  patentClaims       PatentClaim[]
  claimCharts        ClaimChart[]
  specifications     Specification[]
  applicants         Applicant[]
  inventors          Inventor[]
  deadlines          Deadline[]
  filingEvents       FilingEvent[]
  aiAnalyses         AIAnalysis[]
  ipcClassifications PatentProjectIPC[]

  @@index([organizationId])
}

model ProjectMember {
  id              String          @id @default(uuid())
  projectId       String
  project         PatentProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            ProjectRole     @default(INVENTOR)
  permissionLevel PermissionLevel @default(EDIT)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([projectId, userId])
}

model Invitation {
  id              String          @id @default(uuid())
  projectId       String
  project         PatentProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User            @relation("InvitationSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId      String
  receiver        User            @relation("InvitationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  role            ProjectRole
  permissionLevel PermissionLevel @default(EDIT)
  status          String          @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Notification {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     PatentProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  message     String         @db.Text
  type        String         @default("GENERAL") // INVITATION, TASK, REVIEW, DOCUMENT, PATENT, PROTOTYPE, WORKFLOW, FORM, FILING, GENERAL
  referenceId String?
  metadata    Json?
  isRead      Boolean        @default(false)
  readAt      DateTime?
  createdAt   DateTime       @default(now())

  @@index([userId, isRead, createdAt])
  @@index([projectId])
}

model Comment {
  id        String        @id @default(uuid())
  content   String        @db.Text
  projectId String
  project   PatentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ActivityLog {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   PatentProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  action    String
  type      String         @default("GENERAL") // DOCUMENT, AI, PATENT, PROTOTYPE, REVIEW, WORKFLOW, FORM, TASK, FILING, GENERAL
  metadata  Json?
  createdAt DateTime       @default(now())

  @@index([projectId, createdAt])
}

model Document {
  id           String         @id @default(uuid())
  name         String
  fileUrl      String
  fileType     String?
  fileSize     Int?
  version      Int            @default(1)
  category     String         @default("SUPPORTING") // RESEARCH_PAPER, LITERATURE_REVIEW, PATENT_DRAFT, PROTOTYPE, TESTING, SUPPORTING
  projectId    String
  project      PatentProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentDocId  String?
  parentDoc    Document?      @relation("DocumentVersions", fields: [parentDocId], references: [id], onDelete: SetNull)
  childDocs    Document[]     @relation("DocumentVersions")
  patentForm   PatentForm?
  sourceFigures DrawingFigure[] @relation("SourceDocFigures")
  genFigures   DrawingFigure[] @relation("GenDocFigures")
  createdAt    DateTime       @default(now())
}

model Task {
  id          String        @id @default(uuid())
  title       String
  description String?       @db.Text
  status      String        @default("TODO") // TODO, IN_PROGRESS, COMPLETED, CANCELLED
  priority    String        @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate     DateTime?
  completedAt DateTime?
  projectId   String
  project     PatentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   String?
  assignedToId String?
  assignedTo   User?        @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([projectId, status])
  @@index([assignedToId])
}

model Patent {
  id          String   @id @default(uuid())
  title       String
  abstract    String?  @db.Text
  description String?  @db.Text
  claims      String?  @db.Text
  status      String   @default("DRAFT")
  fileUrl     String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Profile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone            String
  dob              DateTime
  gender           String
  institution      String
  department       String
  designation      String
  organization     String?
  researchDomain   String
  bio              String?  @db.Text
  profileImage     String?
  profileCompleted Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PatentReference {
  id             String        @id @default(uuid())
  projectId      String
  project        PatentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  patentNumber   String
  title          String
  abstract       String?       @db.Text
  claims         String?       @db.Text
  url            String?
  inventors      String?
  assignee       String?
  publishDate    DateTime?
  source         String        @default("USPTO") // "USPTO", "EPO", "WIPO"
  claimCharts    ClaimChart[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([projectId, patentNumber])
}

model PatentForm {
  id           String        @id @default(uuid())
  projectId    String
  project      PatentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  formType     String        // "Form 1", "Form 2", "Form 3", "Form 5", "Form 26"
  formData     Json          // Structured key-value fields
  status       String        @default("DRAFT") // DRAFT, SUBMITTED, APPROVED
  version      Int           @default(1)
  createdBy    String?
  documentId   String?       @unique
  document     Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([projectId, formType])
}

model ProjectReview {
  id                String        @id @default(uuid())
  projectId         String
  project           PatentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewerId        String
  reviewer          User          @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewType        String        // "GUIDE_REVIEW", "EXPERT_REVIEW"
  decision          String        // "APPROVED", "REJECTED", "CHANGES_REQUESTED"
  comments          String?       @db.Text
  checklistSnapshot Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Prototype {
  id               String          @id @default(uuid())
  projectId        String
  project          PatentProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title            String
  description      String?         @db.Text
  status           String          @default("DRAFT") // DRAFT, TESTING, COMPLETED
  version          Int             @default(1)
  sourceDocumentId String?
  createdBy        String?
  figures          DrawingFigure[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model DrawingFigure {
  id                  String             @id @default(uuid())
  projectId           String
  project             PatentProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  prototypeId         String?
  prototype           Prototype?         @relation(fields: [prototypeId], references: [id], onDelete: Cascade)
  figureNumber        String             // "FIG. 1", "FIG. 2"
  title               String             // e.g. "Perspective Assembly View"
  description         String?            @db.Text
  analysisStatus      String             @default("PENDING") // PENDING, ANALYZED, FAILED
  confidence          Int?               @default(0)
  disclaimer          String?
  sourceDocumentId    String?
  sourceDocument      Document?          @relation("SourceDocFigures", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  generatedDocumentId String?
  generatedDocument   Document?          @relation("GenDocFigures", fields: [generatedDocumentId], references: [id], onDelete: SetNull)
  components          DrawingComponent[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([projectId, figureNumber])
}

model DrawingComponent {
  id              String         @id @default(uuid())
  figureId        String
  figure          DrawingFigure  @relation(fields: [figureId], references: [id], onDelete: Cascade)
  referenceNumber String         // "100", "102", "104"
  componentName   String         // "Sensor Array"
  description     String?        @db.Text
  xRatio          Float?
  yRatio          Float?
  claimElements   ClaimElement[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model PatentClaim {
  id              String         @id @default(uuid())
  projectId       String
  project         PatentProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  claimNumber     Int            // 1, 2, 3...
  claimType       String         // "INDEPENDENT", "DEPENDENT"
  dependsOnNumber Int?           // Nullable (e.g. 1 for Claim 2 depending on Claim 1)
  preamble        String         // e.g. "An automated system comprising:"
  body            String         @db.Text
  status          String         @default("DRAFT") // DRAFT, REVIEWED, APPROVED
  orderIndex      Int            @default(0)
  linkedFigures   String?        // Comma-separated figure references, e.g. "FIG. 1, FIG. 2"
  claimElements   ClaimElement[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([projectId, claimNumber])
  @@index([projectId, orderIndex])
}

model ClaimElement {
  id            String              @id @default(uuid())
  claimId       String
  claim         PatentClaim         @relation(fields: [claimId], references: [id], onDelete: Cascade)
  elementName   String              // e.g. "Sensor Array"
  elementText   String              @db.Text
  componentId   String?
  component     DrawingComponent?   @relation(fields: [componentId], references: [id], onDelete: SetNull)
  chartMappings ClaimChartElement[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([claimId])
}

model ClaimChart {
  id          String              @id @default(uuid())
  projectId   String
  project     PatentProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  referenceId String
  reference   PatentReference     @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  overallRisk String              @default("LOW") // LOW, MEDIUM, HIGH
  summary     String?             @db.Text
  elements    ClaimChartElement[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([projectId, referenceId])
  @@index([projectId])
}

model ClaimChartElement {
  id              String       @id @default(uuid())
  chartId         String
  chart           ClaimChart   @relation(fields: [chartId], references: [id], onDelete: Cascade)
  claimElementId  String
  claimElement    ClaimElement @relation(fields: [claimElementId], references: [id], onDelete: Cascade)
  priorArtFeature String       @db.Text
  overlapLevel    String       @default("NONE") // "NONE", "PARTIAL", "IDENTICAL", "EQUIVALENT"
  analysisNotes   String?      @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([chartId])
  @@index([claimElementId])
}

model Specification {
  id                      String                 @id @default(uuid())
  projectId               String
  project                 PatentProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title                   String
  abstract                String?                @db.Text
  background              String?                @db.Text
  problem                 String?                @db.Text
  proposedSolution        String?                @db.Text
  summary                 String?                @db.Text
  detailedDescription     String?                @db.Text
  technicalComponents     String?                @db.Text
  workingPrinciple        String?                @db.Text
  advantages              String?                @db.Text
  applications            String?                @db.Text
  industrialApplicability String?                @db.Text
  specificationType       String                 @default("COMPLETE") // "PROVISIONAL" | "COMPLETE"
  status                  String                 @default("DRAFT") // DRAFT, IN_REVIEW, APPROVED, CHANGES_REQUESTED
  currentVersionId        String?
  lastSyncedWithForm2     DateTime?
  version                 Int                    @default(1)
  isCurrent               Boolean                @default(true)
  versions                SpecificationVersion[]
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@index([projectId, isCurrent])
}

model SpecificationVersion {
  id                      String        @id @default(uuid())
  specificationId         String
  specification           Specification @relation(fields: [specificationId], references: [id], onDelete: Cascade)
  versionNumber           Int
  title                   String
  abstract                String?       @db.Text
  background              String?       @db.Text
  problem                 String?       @db.Text
  proposedSolution        String?       @db.Text
  summary                 String?       @db.Text
  detailedDescription     String?       @db.Text
  technicalComponents     String?       @db.Text
  workingPrinciple        String?       @db.Text
  advantages              String?       @db.Text
  applications            String?       @db.Text
  industrialApplicability String?       @db.Text
  savedByUserId           String?
  changeSummary           String?
  isCurrent               Boolean       @default(false)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @default(now()) @updatedAt

  @@index([specificationId, versionNumber])
}

model Applicant {
  id            String        @id @default(uuid())
  projectId     String
  project       PatentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  applicantType String        @default("INDIVIDUAL") // "INDIVIDUAL", "STARTUP", "SMALL_ENTITY", "LARGE_ENTITY", "EDUCATIONAL_INSTITUTE"
  address       String        @db.Text
  country       String        @default("India")
  nationality   String        @default("Indian")
  email         String
  phone         String?
  isPrimary     Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([projectId])
}

model Inventor {
  id                             String        @id @default(uuid())
  projectId                      String
  project                        PatentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                           String
  address                        String        @db.Text
  country                        String        @default("India")
  nationality                    String        @default("Indian")
  email                          String
  phone                          String?
  contribution                   String?       @db.Text
  inventorshipDeclarationSigned Boolean       @default(false)
  orderIndex                     Int           @default(0)
  isPrimary                      Boolean       @default(false)
  createdAt                      DateTime      @default(now())
  updatedAt                      DateTime      @updatedAt

  @@index([projectId, orderIndex])
}

model Deadline {
  id             String        @id @default(uuid())
  projectId      String
  project        PatentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deadlineType   String        // "COMPLETE_SPECIFICATION_FILING", "EXAMINATION_REQUEST_FORM_18", "RESPONSE_TO_FER", "FOREIGN_FILING_PERMISSION"
  referenceEvent String        // "PROVISIONAL_FILING", "PRIORITY_DATE", "FER_ISSUED"
  dueDate        DateTime
  status         String        @default("PENDING") // "PENDING", "MET", "APPROACHING", "OVERDUE"
  completedAt    DateTime?
  description    String?       @db.Text
  reminderSent   Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([projectId, status])
}

model FilingEvent {
  id                String        @id @default(uuid())
  projectId         String
  project           PatentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  eventType         String        // "PROVISIONAL_FILING", "COMPLETE_SPECIFICATION_FILING", "EXAMINATION_REQUEST", "FORM_FILING", "STATUS_CHANGE"
  filingDate        DateTime      @default(now())
  applicationNumber String?
  cbrNumber         String?       // Cash Book Receipt Number (Indian Patent Office)
  referenceNumber   String?
  status            String        @default("FILED")
  description       String?       @db.Text
  documentId        String?
  createdBy         String?
  createdAt         DateTime      @default(now())

  @@index([projectId, eventType])
}

model IPCClassification {
  id            String             @id @default(uuid())
  version       String             @default("2026.01")
  section       String             // A, B, C, D, E, F, G, H
  sectionTitle  String?
  classCode     String             // A01, B65, etc.
  classTitle    String?
  subclass      String             // A01G, B65D, etc.
  subclassTitle String?
  mainGroup     String?
  subgroup      String?
  fullSymbol    String             @unique // e.g. "B65D 85/00"
  title         String             @db.Text
  description   String?            @db.Text
  domain        String?            // "IoT", "Healthcare", "Agriculture", "Energy"
  keywords      String?            @db.Text
  projects      PatentProjectIPC[]
  createdAt     DateTime           @default(now())

  @@index([section, classCode, subclass])
  @@index([domain])
}

model PatentProjectIPC {
  id          String            @id @default(uuid())
  projectId   String
  project     PatentProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ipcId       String
  ipc         IPCClassification @relation(fields: [ipcId], references: [id], onDelete: Cascade)
  isPrimary   Boolean           @default(false)
  confidence  Float?            @default(1.0)
  createdAt   DateTime          @default(now())

  @@unique([projectId, ipcId])
}

model AIAnalysis {
  id               String        @id @default(uuid())
  projectId        String
  project          PatentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId           String?
  analysisType     String        // "CLASSIFICATION_SUGGESTION", "PRIOR_ART_SIMILARITY", "INNOVATION_OVERLAP", "CLAIM_ASSISTANT", "VISION_DRAWING", "FILING_READINESS"
  prompt           String        @db.Text
  model            String        @default("gemini-2.5-flash")
  inputReference   Json?
  output           Json
  safetyDisclaimer String        @default("AI-generated drafting and research assistance — verify technical accuracy and obtain professional legal review before patent filing.")
  createdAt        DateTime      @default(now())

  @@index([projectId, analysisType])
}

model Organization {
  id                 String   @id @default(uuid())
  name               String
  domain             String?
  type               String?  @default("UNIVERSITY")
  location           String?
  address            String?
  contactEmail       String?
  contactNumber      String?
  status             String?  @default("ACTIVE")
  verificationStatus String?  @default("VERIFIED")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users              User[]
  projects           PatentProject[]
  policies           Policy[]
  policyAssignments  PolicyAssignment[]
  subscriptions      Subscription[]
  trial              Trial?
  payments           Payment[]
  entitlements       Entitlement[]
}

model Policy {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?            @db.Text
  rules          Json?
  status         String             @default("ACTIVE") // ACTIVE, INACTIVE
  createdById    String?
  createdBy      User?              @relation("CreatedPolicies", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  assignments    PolicyAssignment[]

  @@index([organizationId, status])
}

model PolicyAssignment {
  id             String       @id @default(uuid())
  policyId       String
  policy         Policy       @relation(fields: [policyId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("UserPolicyAssignments", fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedById   String
  assignedBy     User         @relation("PolicyAssigner", fields: [assignedById], references: [id], onDelete: Cascade)
  assignedAt     DateTime     @default(now())
  expiresAt      DateTime?
  status         String       @default("ACTIVE") // ACTIVE, REVOKED, EXPIRED
  revokedAt      DateTime?
  revokedById    String?
  revokedBy      User?        @relation("PolicyRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, userId])
  @@index([policyId])
  @@index([status])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  category  String?  @default("GENERAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationRequest {
  id              String   @id @default(uuid())
  userId          String
  status          String   @default("PENDING")
  type            String   @default("ROLE_VERIFICATION")
  roleApplied     String?
  organization    String?
  officialEmail   String?
  qualification   String?
  specialization  String?
  experienceYears Int?     @default(0)
  adminNotes      String?  @db.Text
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LoginOtp {
  id          String    @id @default(uuid())
  userId      String
  challengeId String    @unique @default(uuid())
  otpHash     String
  expiresAt   DateTime
  attempts    Int       @default(0)
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([challengeId])
  @@index([expiresAt])
}

model SubscriptionPlan {
  id              String         @id @default(uuid())
  name            String
  code            String         @unique // "FREE_TRIAL", "PRO"
  description     String?        @db.Text
  amount          Int            @default(0) // In smallest unit (paise: 29900 = 299 INR)
  currency        String         @default("INR")
  billingInterval String         @default("MONTHLY") // NONE, MONTHLY, YEARLY
  razorpayPlanId  String?
  features        Json?          // Array of feature strings or details
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  subscriptions   Subscription[]
}

model Subscription {
  id                     String            @id @default(uuid())
  organizationId         String
  organization           Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId                 String
  plan                   SubscriptionPlan  @relation(fields: [planId], references: [id])
  status                 String            @default("TRIALING") // TRIALING, ACTIVE, PAST_DUE, CANCELLED, EXPIRED, PAYMENT_FAILED, INCOMPLETE
  isCurrent              Boolean           @default(true)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  trialStart             DateTime?
  trialEnd               DateTime?
  cancelAtPeriodEnd      Boolean           @default(false)
  cancelledAt            DateTime?
  razorpaySubscriptionId String?           @unique
  razorpayCustomerId     String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  payments               Payment[]
  entitlements           Entitlement[]

  @@index([organizationId, status])
  @@index([organizationId, isCurrent])
}

model Trial {
  id             String       @id @default(uuid())
  organizationId String       @unique // Strictly 1 trial per organization
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  startedAt      DateTime     @default(now())
  expiresAt      DateTime
  status         String       @default("ACTIVE") // ACTIVE, EXPIRED, CONVERTED
  consumedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
}

model Payment {
  id                     String        @id @default(uuid())
  organizationId         String
  organization           Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionId         String?
  subscription           Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amount                 Int           // In paise
  currency               String        @default("INR")
  status                 String        // SUCCESS, FAILED, PENDING
  razorpayPaymentId      String?       @unique
  razorpayOrderId        String?
  razorpaySubscriptionId String?
  razorpaySignature      String?
  paymentMethod          String?       // card, upi, netbanking, etc.
  paidAt                 DateTime?
  failureReason          String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([organizationId])
  @@index([razorpaySubscriptionId])
}

model Entitlement {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  featureCode    String        // AI_INNOVATION_ANALYSIS, PATENT_DRAWING_GENERATION, EXPORT_FILING_PACKAGE
  enabled        Boolean       @default(true)
  validFrom      DateTime      @default(now())
  validUntil     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, featureCode])
  @@index([organizationId, enabled])
}

model WebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventType   String
  payload     Json?
  status      String   @default("PROCESSED") // PROCESSED, FAILED, DUPLICATE, IGNORED
  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([eventId])
  @@index([eventType])
}
